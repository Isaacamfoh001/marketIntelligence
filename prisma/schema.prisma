generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// How the data source is accessed.
enum SourceType {
  AUTOMATED
  SEMI_AUTOMATED
  MANUAL
}

/// Expected update cadence for a data source.
enum ExpectedFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
  AD_HOC
  UNKNOWN
}

/// How data is physically ingested from a source.
enum IngestionMethod {
  API
  FILE_UPLOAD
  FILE_IMPORT
  MANUAL_ENTRY
}

/// Lifecycle status of an ingestion run.
enum IngestionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

/// Observation frequency for macro series.
enum MacroFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

// ---------------------------------------------------------------------------
// Source & Ingestion
// ---------------------------------------------------------------------------

/// Describes a specific dataset/source combination.
///
/// One provider may produce many datasets.  E.g. "Bank of Ghana" produces
/// "BoG Daily Interbank FX", "BoG Treasury Bill Rates", "BoG Monetary
/// Policy Rate", etc.
model DataSource {
  id                String            @id @default(cuid())
  name              String            @unique
  provider          String
  sourceType        SourceType        @default(MANUAL)
  url               String?
  expectedFrequency ExpectedFrequency @default(UNKNOWN)
  ingestionMethod   IngestionMethod   @default(MANUAL_ENTRY)
  active            Boolean           @default(true)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  ingestionRuns     IngestionRun[]
  macroSeries       MacroSeries[]

  @@index([provider])
  @@index([active])
}

/// Records every attempted refresh or import.
///
/// Historical ingestion runs are the system's audit trail.  Deleting a
/// DataSource must NOT silently erase its runs — the FK uses Restrict
/// so deletion is blocked when runs exist.  Deactivate sources instead.
model IngestionRun {
  id              String          @id @default(cuid())
  dataSourceId    String

  startedAt       DateTime        @default(now())
  completedAt     DateTime?

  status          IngestionStatus @default(PENDING)
  recordsRead     Int?
  recordsAccepted Int?
  recordsRejected Int?

  errorMessage    String?
  triggeredBy     String?
  artifactName    String?
  checksum        String?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  dataSource      DataSource      @relation(fields: [dataSourceId], references: [id], onDelete: Restrict)

  macroObservations MacroObservation[]

  @@index([dataSourceId])
  @@index([status])
  @@index([startedAt])
  @@index([completedAt])
}

// ---------------------------------------------------------------------------
// Macro
// ---------------------------------------------------------------------------

/// Metadata about a macroeconomic time series.
///
/// Each series belongs to exactly one DataSource and carries enough
/// descriptive metadata (code, unit, frequency) so that observations
/// are self-describing.
model MacroSeries {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  category    String?
  unit        String
  frequency   MacroFrequency
  sourceId    String

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  source      DataSource      @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  observations MacroObservation[]

  @@index([sourceId])
  @@index([category])
}

/// A single observation for a macro series.
///
/// Uniqueness is enforced on (seriesId, observationDate).  Running the
/// same ingestion twice performs an upsert: if the value changed it is
/// updated, otherwise the row is left untouched.
model MacroObservation {
  id              String    @id @default(cuid())
  seriesId        String
  observationDate DateTime @db.Date
  value           Decimal   @db.Decimal(18, 6)
  retrievedAt     DateTime  @default(now())
  ingestionRunId  String

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  series          MacroSeries  @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  ingestionRun    IngestionRun @relation(fields: [ingestionRunId], references: [id], onDelete: Restrict)

  @@unique([seriesId, observationDate])
  @@index([seriesId])
  @@index([observationDate])
  @@index([ingestionRunId])
}
