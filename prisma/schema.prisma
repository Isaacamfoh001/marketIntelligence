generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// How the data source is accessed.
enum SourceType {
  AUTOMATED
  SEMI_AUTOMATED
  MANUAL
}

/// Expected update cadence for a data source.
enum ExpectedFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
  AD_HOC
  UNKNOWN
}

/// How data is physically ingested from a source.
enum IngestionMethod {
  API
  /// Automated retrieval by fetching and parsing an official web page —
  /// used when a provider publishes data as a rendered page/table rather
  /// than a documented API or downloadable file (e.g. Bank of Ghana).
  HTML_FETCH
  FILE_UPLOAD
  FILE_IMPORT
  MANUAL_ENTRY
}

/// Lifecycle status of an ingestion run.
enum IngestionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

/// Outcome of a Monetary Policy Committee decision relative to the prior
/// decision.
enum PolicyDecisionType {
  HIKE
  CUT
  HOLD
}

/// Classification of a traded instrument. GSE's board lists ordinary
/// shares alongside a small number of preference shares, depositary
/// receipts, and one ETF — classified from the import file's own
/// security-type column when present, defaulting to ORDINARY_SHARE
/// rather than guessing (CLAUDE.md §12: "do not spend excessive time
/// constructing perfect issuer master data in M6").
enum SecurityType {
  ORDINARY_SHARE
  PREFERENCE_SHARE
  DEPOSITARY_SHARE
  ETF
}

/// Government vs corporate issuance — distinguished from `instrumentType`
/// (which also encodes the actual instrument shape) so a UI filter
/// ("Government Only"/"Corporate Only" — M7 §14) can group on classification
/// alone without re-deriving it from instrument type in every call site.
enum FixedIncomeClassification {
  SOVEREIGN
  CORPORATE
}

/// Treasury bills are NOT modeled here — they already have a complete,
/// working RATE domain (TreasuryInstrument/TreasuryRate, M4) that this milestone
/// explicitly must not duplicate (M7 §3: "We do NOT want another page that
/// simply duplicates Treasury rates"). FixedIncomeSecurity models the two
/// coupon-bearing instrument shapes Treasury doesn't cover. A bill a portfolio
/// HOLDS (a specific maturing instrument) is the separate TreasuryBill model
/// (M8.5): a discount instrument with one payment and a different pricing
/// convention (simple Act/365), not a coupon bond.
enum FixedIncomeInstrumentType {
  GOVERNMENT_BOND
  CORPORATE_BOND
}

/// FLOATING is modeled for completeness (M7 §4) but this milestone's
/// cash-flow/YTM/duration engine only computes analytics for FIXED —
/// a floating coupon's future reset path is unknown and a deterministic
/// schedule cannot honestly be produced for it (M7 §7: "do not display
/// meaningless metrics for instruments where they are not applicable").
enum CouponType {
  FIXED
  FLOATING
  ZERO_COUPON
}

/// Null only for ZERO_COUPON instruments, which have no periodic coupon at
/// all — never a manufactured "frequency" for a schedule that doesn't exist.
enum CouponFrequency {
  ANNUAL
  SEMI_ANNUAL
  QUARTERLY
  MONTHLY
}

enum FixedIncomeSecurityStatus {
  ACTIVE
  MATURED
  CALLED
  DEFAULTED
}

/// Distinguishes WHERE a price/yield observation came from — never
/// interchangeable (M7.1 §8/§9): a primary-auction clearing rate (set by
/// BoG at issuance, competing bids) and a secondary-market traded
/// price/yield (set by subsequent buyers/sellers) answer different
/// questions, and conflating them would misrepresent what a stored number
/// actually means.
enum ObservationKind {
  AUCTION_PRIMARY
  SECONDARY_MARKET
}

/// Whether the source reports an actual trade on the observation date
/// (M7.3.1). GFIM's daily report publishes a closing price for EVERY listed
/// security — for one that did not trade, that price is the last trade's
/// price carried forward, possibly from months or years earlier. Only a
/// TRADED observation is a dated market price; NOT_TRADED rows are kept for
/// provenance but never treated as current market evidence. Null for
/// sources that don't report trade activity (manual CSV imports, primary
/// auction results).
enum ObservationTradeStatus {
  TRADED
  NOT_TRADED
}

/// Observation frequency for macro series.
enum MacroFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
  /// Event-driven series with no fixed calendar cadence, e.g. a policy
  /// rate that changes only on MPC decision dates. Observations are
  /// stored per real decision/effective date — never one manufactured
  /// row per calendar month.
  AD_HOC
}

// ---------------------------------------------------------------------------
// Source & Ingestion
// ---------------------------------------------------------------------------

/// Describes a specific dataset/source combination.
///
/// One provider may produce many datasets.  E.g. "Bank of Ghana" produces
/// "BoG Daily Interbank FX", "BoG Treasury Bill Rates", "BoG Monetary
/// Policy Rate", etc.
model DataSource {
  id                String            @id @default(cuid())
  name              String            @unique
  provider          String
  sourceType        SourceType        @default(MANUAL)
  url               String?
  expectedFrequency ExpectedFrequency @default(UNKNOWN)
  ingestionMethod   IngestionMethod   @default(MANUAL_ENTRY)
  active            Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingestionRuns                IngestionRun[]
  macroSeries                  MacroSeries[]
  exchangeRates                ExchangeRate[]
  treasuryRates                TreasuryRate[]
  policyDecisions              PolicyDecision[]
  marketIndexObservations      MarketIndexObservation[]
  marketSummaries              MarketSummary[]
  securityPrices               SecurityPrice[]
  companyFinancialObservations CompanyFinancialObservation[]
  fixedIncomeSecurities        FixedIncomeSecurity[]
  fixedIncomeObservations      FixedIncomeObservation[]

  @@index([provider])
  @@index([active])
}

/// Records every attempted refresh or import.
///
/// Historical ingestion runs are the system's audit trail.  Deleting a
/// DataSource must NOT silently erase its runs — the FK uses Restrict
/// so deletion is blocked when runs exist.  Deactivate sources instead.
model IngestionRun {
  id           String @id @default(cuid())
  dataSourceId String

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  status          IngestionStatus @default(PENDING)
  recordsRead     Int?
  recordsAccepted Int?
  recordsRejected Int?

  errorMessage      String?
  triggeredBy       String?
  artifactName      String?
  checksum          String?
  /// How the underlying SOURCE DOCUMENT was acquired — distinct from
  /// `triggeredBy` (who/what ran the import) and from DataSource.provider
  /// (who publishes it). M7.1 §39: never conflate acquisition mechanism
  /// with publisher. Free text rather than an enum (values in practice:
  /// "OFFICIAL_WEB_FETCH" — fetched from a first-party official URL and
  /// transcribed/imported; "MANUAL_FILE_IMPORT" — a human supplied an
  /// already-obtained file; "STRUCTURED_IMPORT" — CSV/Excel with no
  /// separate source document, e.g. GSE market data. Null for domains
  /// that predate this field.
  acquisitionMethod String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataSource DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Restrict)

  macroObservations            MacroObservation[]
  exchangeRates                ExchangeRate[]
  treasuryRates                TreasuryRate[]
  policyDecisions              PolicyDecision[]
  marketIndexObservations      MarketIndexObservation[]
  marketSummaries              MarketSummary[]
  securityPrices               SecurityPrice[]
  companyFinancialObservations CompanyFinancialObservation[]
  fixedIncomeSecurities        FixedIncomeSecurity[]
  fixedIncomeObservations      FixedIncomeObservation[]

  @@index([dataSourceId])
  @@index([status])
  @@index([startedAt])
  @@index([completedAt])
}

// ---------------------------------------------------------------------------
// Macro
// ---------------------------------------------------------------------------

/// Metadata about a macroeconomic time series.
///
/// Each series belongs to exactly one DataSource and carries enough
/// descriptive metadata (code, unit, frequency) so that observations
/// are self-describing.
model MacroSeries {
  id        String         @id @default(cuid())
  code      String         @unique
  name      String
  category  String?
  unit      String
  frequency MacroFrequency
  sourceId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source       DataSource         @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  observations MacroObservation[]

  @@index([sourceId])
  @@index([category])
}

/// A single observation for a macro series.
///
/// Uniqueness is enforced on (seriesId, observationDate).  Running the
/// same ingestion twice performs an upsert: if the value changed it is
/// updated, otherwise the row is left untouched.
///
/// `revisionStatus` is nullable and currently unpopulated by any
/// provider: GSS's StatsBank/PxWeb tables don't expose a structured
/// provisional/revised flag on individual data points (verified by
/// inspection of the JSON-stat2 "status" codes, which only mark missing
/// data, not revision state). The column exists so a future source that
/// does expose this can populate it without a schema change — not
/// speculative modeling of data that isn't there.
model MacroObservation {
  id              String   @id @default(cuid())
  seriesId        String
  observationDate DateTime @db.Date
  value           Decimal  @db.Decimal(18, 6)
  revisionStatus  String?
  retrievedAt     DateTime @default(now())
  ingestionRunId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  series       MacroSeries  @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  ingestionRun IngestionRun @relation(fields: [ingestionRunId], references: [id], onDelete: Restrict)

  @@unique([seriesId, observationDate])
  @@index([seriesId])
  @@index([observationDate])
  @@index([ingestionRunId])
}

// ---------------------------------------------------------------------------
// FX
// ---------------------------------------------------------------------------

/// A traded currency pair, e.g. USDGHS (US Dollar priced in Ghana Cedis).
///
/// Pair identity is source-agnostic: the same pair may in future be priced
/// by more than one provider. Source attribution lives on ExchangeRate,
/// not here.
model CurrencyPair {
  id            String  @id @default(cuid())
  code          String  @unique
  baseCurrency  String
  quoteCurrency String
  active        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exchangeRates ExchangeRate[]

  @@index([active])
}

/// A single day's published exchange rate for a currency pair.
///
/// Design: one row per (currencyPair, observationDate) carrying buying,
/// selling, and mid rate together (rather than one row per rate type).
/// Bank of Ghana publishes buy/sell/mid as a single atomic daily quote —
/// they are three views of the same observation, not independently timed
/// readings — so storing them together keeps the sanity check
/// (buying <= mid <= selling), the Overview mid-rate chart, and the
/// "what changed" comparison all single-row operations instead of
/// self-joins across rate-type rows.
///
/// buyingRate/sellingRate are nullable because a source may occasionally
/// publish only a mid rate; midRate is required because it is the
/// primary value the rest of the application relies on — a row without
/// it is rejected during validation rather than stored with a fabricated
/// value. Missing must not become zero.
model ExchangeRate {
  id              String   @id @default(cuid())
  currencyPairId  String
  observationDate DateTime @db.Date

  buyingRate  Decimal? @db.Decimal(18, 6)
  sellingRate Decimal? @db.Decimal(18, 6)
  midRate     Decimal  @db.Decimal(18, 6)

  sourceId       String
  ingestionRunId String
  retrievedAt    DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currencyPair CurrencyPair @relation(fields: [currencyPairId], references: [id], onDelete: Restrict)
  source       DataSource   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  ingestionRun IngestionRun @relation(fields: [ingestionRunId], references: [id], onDelete: Restrict)

  @@unique([currencyPairId, observationDate])
  @@index([currencyPairId])
  @@index([observationDate])
  @@index([sourceId])
  @@index([ingestionRunId])
}

// ---------------------------------------------------------------------------
// Treasury
// ---------------------------------------------------------------------------

/// A specific Treasury security BoG auctions, e.g. the 91-day bill.
///
/// `instrumentType` is a plain string ("BILL" today) rather than an enum:
/// BoG's own security-type filter already lists ~13 tenors across bills,
/// notes, and bonds, and V1 only needs bills — modeling the rest as an
/// enum now would be speculative schema for instruments this milestone
/// doesn't ingest.
model TreasuryInstrument {
  id             String  @id @default(cuid())
  code           String  @unique
  name           String
  tenorDays      Int
  currency       String  @default("GHS")
  instrumentType String
  active         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  treasuryRates TreasuryRate[]
  heldBills     TreasuryBill[]

  @@index([active])
}

/// A specific Treasury bill that can be HELD in a portfolio (M8.5) — an
/// instrument, not a rate series. Identity is (instrument/tenor, maturityDate);
/// `issueDate` is implied (maturityDate − tenor) and kept for provenance.
///
/// PROVENANCE: the terms are ANALYST-ENTERED — Korbly's BoG ingestion publishes
/// auction RATES only (no per-bill maturity dates or ISINs), so no bill identity
/// is fabricated from it. `isin` is optional and never invented. The valuation
/// EVIDENCE (the auction rates) keeps full TreasuryRate → DataSource →
/// IngestionRun provenance. There is no purchase amount/price/date here: face
/// value belongs to the position and no cost basis is recorded (M8 scope).
model TreasuryBill {
  id           String   @id @default(cuid())
  instrumentId String
  issueDate    DateTime @db.Date
  maturityDate DateTime @db.Date
  isin         String?  @unique
  currency     String   @default("GHS")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instrument         TreasuryInstrument  @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  portfolioPositions PortfolioPosition[]
  scenarioShocks     ScenarioShock[]

  @@unique([instrumentId, maturityDate])
  @@index([maturityDate])
}

/// A single auction/issue-date observation for a Treasury instrument.
///
/// Both discountRate and interestRate are required: Bank of Ghana
/// publishes them together as one atomic auction result (every observed
/// row carries both), and the Overview headline uses interestRate while
/// discountRate is retained rather than discarded — a row missing either
/// is rejected during validation, never stored with a fabricated value.
/// `tenderNumber` preserves BoG's own auction identifier for traceability.
///
/// Verified convention (M7.1 §9, src/lib/treasury-rate-convention.ts):
/// discountRate is the annualized discount off FACE value (what the
/// auction clears on); interestRate is the annualized return on the PRICE
/// PAID ("interest rate equivalent" / true yield), always >= discountRate.
/// interestRate is the field comparable to a coupon bond's YTM — both
/// measure annualized return on amount invested — and is therefore the
/// correct (and already-used) field for the Fixed Income sovereign yield
/// curve and spread comparisons. discountRate is never used for that
/// purpose. See treasury-rate-convention.test.ts for verification against
/// every TreasuryRate row in the database.
model TreasuryRate {
  id              String   @id @default(cuid())
  instrumentId    String
  observationDate DateTime @db.Date
  tenderNumber    String?

  discountRate Decimal @db.Decimal(9, 4)
  interestRate Decimal @db.Decimal(9, 4)

  sourceId       String
  ingestionRunId String
  retrievedAt    DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instrument   TreasuryInstrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  source       DataSource         @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  ingestionRun IngestionRun       @relation(fields: [ingestionRunId], references: [id], onDelete: Restrict)

  @@unique([instrumentId, observationDate])
  @@index([instrumentId])
  @@index([observationDate])
  @@index([sourceId])
  @@index([ingestionRunId])
}

// ---------------------------------------------------------------------------
// Monetary Policy
// ---------------------------------------------------------------------------

/// A single Monetary Policy Committee decision.
///
/// Deliberately not modeled as a MacroObservation: MPR is event-driven
/// (decisionType/changeBps have no meaning in a plain numeric time
/// series), and forcing HOLD/CUT/HIKE semantics into MacroObservation's
/// bare (date, value) shape would make that domain confusing for its
/// other, genuinely numeric series. This is the "minimal policy-decision
/// model" option.
///
/// `resultingRate` is always the rate in force after this decision —
/// including for HOLD, where it equals the previous decision's rate.
/// `changeBps` is null only for the very first decision Korbly has on
/// record (2002), which has no prior decision to compare against.
model PolicyDecision {
  id            String             @id @default(cuid())
  decisionDate  DateTime           @db.Date
  resultingRate Decimal            @db.Decimal(9, 4)
  decisionType  PolicyDecisionType
  changeBps     Int?

  sourceId       String
  ingestionRunId String
  retrievedAt    DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source       DataSource   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  ingestionRun IngestionRun @relation(fields: [ingestionRunId], references: [id], onDelete: Restrict)

  @@unique([decisionDate])
  @@index([decisionDate])
  @@index([sourceId])
  @@index([ingestionRunId])
}

// ---------------------------------------------------------------------------
// Ghana Stock Exchange — Markets & Equities (M6)
// ---------------------------------------------------------------------------

/// A published GSE market index, e.g. the Composite Index (GSE-CI) or the
/// Financial Stocks Index (GSE-FSI). Index *levels* are always ingested
/// from GSE's own published index/market-summary data — never derived by
/// Korbly from constituent security prices (CLAUDE.md: "do not reconstruct
/// GSE-CI from constituent prices if that leads to errors or
/// inconsistencies" — an index derivation would also silently depend on
/// Korbly having complete, correctly-weighted constituent coverage, which
/// it does not).
model MarketIndex {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  exchange String  @default("Ghana Stock Exchange")
  currency String  @default("GHS")
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  observations MarketIndexObservation[]

  @@index([active])
}

/// A single trading day's published level for one index.
///
/// `changePct` is populated only when the source itself publishes a daily
/// change figure alongside the level (a raw fact from the source) — it is
/// never computed and written back by Korbly. Application code that needs
/// 1D/1M/YTD/1Y returns computes them at read time from stored levels via
/// the shared returns engine (src/lib/returns.ts), so there is exactly one
/// place that implements "latest valid observation on or before the
/// comparison date" — not two definitions that can drift apart.
model MarketIndexObservation {
  id              String   @id @default(cuid())
  marketIndexId   String
  observationDate DateTime @db.Date
  level           Decimal  @db.Decimal(18, 4)
  changePct       Decimal? @db.Decimal(9, 4)

  sourceId       String
  ingestionRunId String
  retrievedAt    DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  marketIndex  MarketIndex  @relation(fields: [marketIndexId], references: [id], onDelete: Restrict)
  source       DataSource   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  ingestionRun IngestionRun @relation(fields: [ingestionRunId], references: [id], onDelete: Restrict)

  @@unique([marketIndexId, observationDate])
  @@index([marketIndexId])
  @@index([observationDate])
  @@index([sourceId])
  @@index([ingestionRunId])
}

/// Whole-market daily figures (total volume, total value traded, market
/// capitalization) as published by GSE's Daily Market Summary.
///
/// Deliberately separate from MarketIndexObservation: these are
/// market-wide facts, not a property of any one index, and a summary row
/// may exist for a day even when only one of the two indices is present
/// (or vice versa) — folding them together would force an artificial
/// pairing between two things that are conceptually and temporally
/// independent (CLAUDE.md: "do not shoehorn total-market fields into an
/// individual index observation").
model MarketSummary {
  id          String   @id @default(cuid())
  tradingDate DateTime @unique @db.Date

  totalVolume         BigInt?
  totalValueTradedGhs Decimal? @db.Decimal(20, 2)
  marketCapGhs        Decimal? @db.Decimal(20, 2)

  sourceId       String
  ingestionRunId String
  retrievedAt    DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source       DataSource   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  ingestionRun IngestionRun @relation(fields: [ingestionRunId], references: [id], onDelete: Restrict)

  @@index([sourceId])
  @@index([ingestionRunId])
}

/// A listed issuer. Kept separate from Security so one company's multiple
/// traded instruments (e.g. an ordinary share and a preference share)
/// share one issuer identity rather than duplicating company metadata.
/// `ticker` duplicates Security.ticker's identity deliberately: Security
/// represents a traded *instrument* (M6's domain), while Company is the
/// *issuer* that M7's financial statements attach to. The two must be
/// resolvable independently — financials should be importable for a
/// company even before any GSE price data exists for it — so Company
/// cannot rely solely on a join through Security to know its own ticker.
/// Kept in sync at creation time (see gse-security-provider.ts and
/// financials-provider.ts); both ultimately point at the same Company row
/// once both exist.
model Company {
  id       String  @id @default(cuid())
  name     String
  ticker   String? @unique
  sector   String?
  exchange String  @default("Ghana Stock Exchange")
  currency String  @default("GHS")
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  securities            Security[]
  financialPeriods      FinancialPeriod[]
  fixedIncomeSecurities FixedIncomeSecurity[]
  scenarioShocks        ScenarioShock[]

  @@index([active])
}

// ---------------------------------------------------------------------------
// Company Financials (M7)
// ---------------------------------------------------------------------------

/// Names the period directly rather than pairing a coarse "type" with a
/// separately-interpreted numeric slot (M7.1 §17 fix — M7's original
/// `periodType: HALF_YEAR` + `fiscalQuarter: 1|2` meaning "H1 or H2"
/// worked but overloaded an integer's meaning by context; naming H1/H2/
/// Q1-Q4/NINE_MONTH directly removes that indirection entirely, and adds
/// NINE_MONTH — a real interim shape some issuers report — that the old
/// convention had no slot for at all).
enum FiscalPeriod {
  ANNUAL
  Q1
  Q2
  Q3
  Q4
  H1
  H2
  NINE_MONTH
}

/// Whether a statement covers the group (consolidated) or the parent
/// entity alone (separate) — never mixed silently across periods
/// (CLAUDE.md: comparability must be explicit, not assumed).
enum StatementScope {
  CONSOLIDATED
  SEPARATE
}

/// Canonical storage unit for a FinancialMetric's normalized `value`.
/// GHS_THOUSANDS/GHS_MILLIONS appear only as *input* scale indicators on
/// an import row (see financials-parser.ts) — every stored, normalized
/// value is always in one of GHS / PERCENT / PER_SHARE_GHS / COUNT, never
/// left scaled, so charts and ratios never have to guess a statement's
/// reporting unit.
enum MetricUnit {
  GHS
  GHS_THOUSANDS
  GHS_MILLIONS
  PERCENT
  PER_SHARE_GHS
  COUNT
}

/// A single reporting period for one company. `period` alone fully
/// identifies the period shape (ANNUAL/Q1-Q4/H1-H2/NINE_MONTH) — no
/// separate numeric field to misinterpret.
///
/// H1 2026 and FY 2025 are never the same kind of row (CLAUDE.md /
/// PROJECT.md: never compare interim to annual as though equivalent) —
/// `period` is part of identity, not just a label.
model FinancialPeriod {
  id                String         @id @default(cuid())
  companyId         String
  period            FiscalPeriod
  fiscalYear        Int
  startDate         DateTime       @db.Date
  endDate           DateTime       @db.Date
  reportingCurrency String         @default("GHS")
  statementScope    StatementScope @default(CONSOLIDATED)
  audited           Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company                       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  observations CompanyFinancialObservation[]

  @@unique([companyId, period, fiscalYear, statementScope])
  @@index([companyId])
  @@index([fiscalYear])
}

/// Metadata for one canonical metric code (e.g. "REVENUE"). `unit` is the
/// metric's own canonical storage unit — always what `value` on every
/// observation of this metric is expressed in, regardless of what unit
/// the original statement reported it in.
model FinancialMetric {
  id       String     @id @default(cuid())
  code     String     @unique
  name     String
  unit     MetricUnit
  category String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  observations CompanyFinancialObservation[]

  @@index([category])
}

/// A single normalized metric value for one financial period.
///
/// `value` is always normalized into the metric's canonical unit (see
/// FinancialMetric.unit) — e.g. a statement reporting "Revenue 12,450"
/// with unit GHS_MILLIONS is stored as value = 12,450,000,000, never as
/// the raw 12,450 (CLAUDE.md: a critical financial-correctness
/// requirement — never silently drop a statement's reporting scale).
/// `reportedValue`/`reportedUnit` preserve exactly what the statement
/// said, so a user can always trace the normalization back to source.
///
/// Uniqueness on (financialPeriodId, metricId) is the full "company +
/// period + metric + statement scope" key from CLAUDE.md/M7 §20:
/// financialPeriodId already encodes company, period, and scope via
/// FinancialPeriod's own unique constraint.
model CompanyFinancialObservation {
  id                String @id @default(cuid())
  financialPeriodId String
  metricId          String

  value         Decimal  @db.Decimal(20, 4)
  reportedValue Decimal? @db.Decimal(20, 4)
  reportedUnit  String?

  sourceId       String
  ingestionRunId String
  retrievedAt    DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financialPeriod FinancialPeriod @relation(fields: [financialPeriodId], references: [id], onDelete: Restrict)
  metric          FinancialMetric @relation(fields: [metricId], references: [id], onDelete: Restrict)
  source          DataSource      @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  ingestionRun    IngestionRun    @relation(fields: [ingestionRunId], references: [id], onDelete: Restrict)

  @@unique([financialPeriodId, metricId])
  @@index([financialPeriodId])
  @@index([metricId])
  @@index([sourceId])
  @@index([ingestionRunId])
}

/// A specific traded instrument. `ticker` is the GSE share code (e.g.
/// "MTNGH") and is globally unique on the exchange regardless of issuer.
model Security {
  id           String       @id @default(cuid())
  companyId    String
  ticker       String       @unique
  securityType SecurityType @default(ORDINARY_SHARE)
  currency     String       @default("GHS")
  active       Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  prices             SecurityPrice[]
  portfolioPositions PortfolioPosition[]
  scenarioShocks     ScenarioShock[]

  @@index([companyId])
  @@index([active])
}

/// A single trading day's published price record for one security.
///
/// Field set mirrors GSE's own Daily Shares & ETFs publication exactly
/// (see gse-security-parser.ts). `closeVwap` is the ONLY required price
/// field and is the primary value the rest of the application displays —
/// GSE's "Closing Price - VWAP" is a volume-weighted average close, and is
/// documented here as the display convention precisely so no call site
/// ever silently substitutes `lastTransactionPrice` for it. Every other
/// price/quote field is nullable: GSE may not publish a bid/offer or a
/// year high/low for a thinly-traded line on a given day, and a blank
/// cell must be stored as missing, never coerced to 0 (CLAUDE.md §14).
/// `volume`/`valueTradedGhs` are also nullable for the same reason, but an
/// explicit "0" in the source file (a real no-trade day) is stored as the
/// number 0 — the parser distinguishes the two cases, not this schema.
model SecurityPrice {
  id          String   @id @default(cuid())
  securityId  String
  tradingDate DateTime @db.Date

  previousCloseVwap    Decimal? @db.Decimal(18, 4)
  openPrice            Decimal? @db.Decimal(18, 4)
  lastTransactionPrice Decimal? @db.Decimal(18, 4)
  closeVwap            Decimal  @db.Decimal(18, 4)
  priceChange          Decimal? @db.Decimal(18, 4)
  yearHigh             Decimal? @db.Decimal(18, 4)
  yearLow              Decimal? @db.Decimal(18, 4)
  closingBid           Decimal? @db.Decimal(18, 4)
  closingOffer         Decimal? @db.Decimal(18, 4)
  volume               BigInt?
  valueTradedGhs       Decimal? @db.Decimal(20, 2)

  sourceId       String
  ingestionRunId String
  retrievedAt    DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  security     Security     @relation(fields: [securityId], references: [id], onDelete: Restrict)
  source       DataSource   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  ingestionRun IngestionRun @relation(fields: [ingestionRunId], references: [id], onDelete: Restrict)

  @@unique([securityId, tradingDate])
  @@index([securityId])
  @@index([tradingDate])
  @@index([sourceId])
  @@index([ingestionRunId])
}

// ---------------------------------------------------------------------------
// Fixed Income (M7) — coupon-bearing bonds only. Treasury-bill RATES stay in the
// TreasuryInstrument/TreasuryRate domain above (held bills: TreasuryBill); see
// FixedIncomeInstrumentType for why they are not duplicated here.
// ---------------------------------------------------------------------------

/// A specific fixed-income instrument's contractual identity — issuer,
/// tenor, and coupon terms. One row per issue, created by an import of the
/// instrument's actual term sheet/prospectus, which is why — unlike
/// TreasuryInstrument/MarketIndex/Security's near-static identity rows —
/// this carries full source provenance directly on the identity row itself:
/// the contractual terms ARE the ingested fact here, not merely a reference
/// code (CLAUDE.md §1: "never store a market number without knowing its
/// source" applies equally to "what coupon does this bond pay").
///
/// `companyId` is nullable and deliberately reuses the existing Company
/// model as the general issuer identity (CLAUDE.md §4: reuse existing
/// patterns, do not invent a parallel "Issuer" model) — including for a
/// sovereign issuer (e.g. a single "Government of Ghana" Company row with
/// no ticker and sector "Sovereign"), not only GSE-listed corporates. It is
/// nullable only because a corporate bond's issuer may not yet have been
/// created as a Company by any import (an issuer not registered until its
/// first bond import, mirroring how `ensureCompanyByTicker` lazily creates
/// Company rows for GSE equities/financials).
model FixedIncomeSecurity {
  id             String  @id @default(cuid())
  instrumentCode String  @unique
  /// International Securities Identification Number, when the issuer/
  /// exchange has published one (M7.1 §4). Nullable — never fabricated
  /// when a source doesn't supply it.
  isin           String? @unique
  instrumentName String
  issuerName     String
  companyId      String?

  instrumentType  FixedIncomeInstrumentType
  classification  FixedIncomeClassification
  currency        String                    @default("GHS")
  issueDate       DateTime                  @db.Date
  maturityDate    DateTime                  @db.Date
  couponType      CouponType
  couponRatePct   Decimal?                  @db.Decimal(9, 4)
  couponFrequency CouponFrequency?
  faceValue       Decimal                   @default(100) @db.Decimal(18, 2)
  status          FixedIncomeSecurityStatus @default(ACTIVE)

  sourceId       String
  ingestionRunId String
  retrievedAt    DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company            Company?                 @relation(fields: [companyId], references: [id], onDelete: SetNull)
  source             DataSource               @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  ingestionRun       IngestionRun             @relation(fields: [ingestionRunId], references: [id], onDelete: Restrict)
  observations       FixedIncomeObservation[]
  portfolioPositions PortfolioPosition[]
  scenarioShocks     ScenarioShock[]

  @@index([instrumentType])
  @@index([classification])
  @@index([maturityDate])
  @@index([companyId])
  @@index([sourceId])
  @@index([ingestionRunId])
}

/// A single market observation (price and/or yield) for one fixed-income
/// security on one date. `cleanPrice` and `sourceYieldPct` are both
/// nullable at the schema level — a GFIM quote may publish only a yield or
/// only a price — but the parser (fixed-income-observations-parser.ts)
/// rejects any row supplying neither, so a persisted row always carries at
/// least one real market fact. Dirty price and accrued interest are
/// deliberately NOT stored here: both are always deterministically
/// calculable from cleanPrice + the security's own coupon terms via the
/// cash-flow engine (CLAUDE.md §1: never store a value that should
/// obviously be computed).
model FixedIncomeObservation {
  id              String   @id @default(cuid())
  securityId      String
  observationDate DateTime @db.Date

  cleanPrice                Decimal?                @db.Decimal(12, 4)
  sourceYieldPct            Decimal?                @db.Decimal(9, 4)
  volumeTradedGhs           Decimal?                @db.Decimal(20, 2)
  /// Primary auction clearing rate vs. secondary-market trade — see
  /// ObservationKind. Required: every observation must state which kind
  /// it is, never left ambiguous (M7.1 §8).
  observationKind           ObservationKind
  /// See ObservationTradeStatus. Null = source does not report trade activity.
  tradeStatus               ObservationTradeStatus?
  /// Number of trades the source reports for this security on this date.
  numberOfTrades            Int?
  /// The security description and maturity date exactly as printed on the
  /// source row (M7.3.1) — provenance for checking that the ISIN match and
  /// the Securities Master's contractual terms agree with what the source
  /// itself says. Never used as terms; only compared against them.
  sourceSecurityDescription String?
  sourceMaturityDate        DateTime?               @db.Date

  sourceId       String
  ingestionRunId String
  retrievedAt    DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  security     FixedIncomeSecurity @relation(fields: [securityId], references: [id], onDelete: Restrict)
  source       DataSource          @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  ingestionRun IngestionRun        @relation(fields: [ingestionRunId], references: [id], onDelete: Restrict)

  @@unique([securityId, observationDate])
  @@index([securityId])
  @@index([observationDate])
  @@index([sourceId])
  @@index([ingestionRunId])
}

// ---------------------------------------------------------------------------
// Portfolios (M8.1) — an analyst-recorded set of holdings, valued by the pure
// domain layer in src/lib/portfolio/. Positions record ONLY what the analyst
// holds (nominal GHS for bonds, whole shares for equities): no cost basis,
// lots, transactions or P/L, and no stored valuation — a reference value is
// always recomputed from the latest market data so it can never go stale in
// the database.
//
// OWNERSHIP (M8 internal MVP): a single shared, unauthenticated workspace.
// There is deliberately no owner column yet; adding a nullable `ownerId` to
// Portfolio later is a non-breaking migration. Portfolio mutations MUST NOT be
// exposed on a public deployment without authentication/authorisation.
// ---------------------------------------------------------------------------

enum PortfolioAssetClass {
  BOND
  EQUITY
  /// A held Treasury bill (M8.5): treasuryBillId + faceValueGhs (stored in nominalGhs).
  TREASURY_BILL
}

model Portfolio {
  id          String    @id @default(cuid())
  name        String
  description String?
  /// Soft archive — an archived portfolio leaves the active list but keeps its positions.
  archivedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positions PortfolioPosition[]
  scenarios Scenario[]

  @@index([archivedAt])
}

/// One holding. Exactly one instrument reference is set, matching `assetClass`
/// (enforced by the "PortfolioPosition_shape_check" CHECK constraint in the
/// migration, which Prisma cannot express):
///   BOND          → fixedIncomeSecurityId + nominalGhs (> 0, GHS face amount); securityId, shares, treasuryBillId null
///   EQUITY        → securityId + shares (> 0, whole shares);                  fixedIncomeSecurityId, nominalGhs, treasuryBillId null
///   TREASURY_BILL → treasuryBillId + nominalGhs (> 0, GHS FACE / maturity amount — not purchase cost, not value); the rest null
/// One position per instrument per portfolio (the two unique indexes; Postgres
/// treats NULLs as distinct so each applies only to its own asset class).
/// Instruments are never deleted from under a portfolio (Restrict).
model PortfolioPosition {
  id          String              @id @default(cuid())
  portfolioId String
  assetClass  PortfolioAssetClass

  fixedIncomeSecurityId String?
  /// Nominal (face) amount held, in GHS. Never a quantity of units.
  nominalGhs            Decimal? @db.Decimal(20, 2)

  securityId String?
  /// Whole shares held.
  shares     Int?

  /// Treasury bill held; its face (maturity) amount is `nominalGhs`.
  treasuryBillId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  treasuryBill        TreasuryBill?        @relation(fields: [treasuryBillId], references: [id], onDelete: Restrict)
  portfolio           Portfolio            @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  fixedIncomeSecurity FixedIncomeSecurity? @relation(fields: [fixedIncomeSecurityId], references: [id], onDelete: Restrict)
  security            Security?            @relation(fields: [securityId], references: [id], onDelete: Restrict)

  @@unique([portfolioId, fixedIncomeSecurityId])
  @@unique([portfolioId, securityId])
  @@unique([portfolioId, treasuryBillId])
  @@index([treasuryBillId])
  @@index([portfolioId])
  @@index([fixedIncomeSecurityId])
  @@index([securityId])
}

// ---------------------------------------------------------------------------
// Scenarios (M8.3) — saved ASSUMPTIONS only. A scenario is a named set of
// explicit shocks; its results are never stored (they are recomputed from the
// current portfolio + reference valuation + these assumptions by the pure
// engine in src/lib/scenarios/). ScenarioRun snapshots are M8.5.
//
// SELECTOR INTEGRITY: instead of a free `selectorKey` string, each shock row
// carries typed, nullable target columns. Exactly one is set, matching
// `targetKind` (CHECK "ScenarioShock_target_check" in the migration):
//   ASSET_CLASS → assetClass (enum)
//   SECURITY    → fixedIncomeSecurityId (FK) XOR securityId (FK)
//   ISSUER      → companyId (FK) XOR issuerNameKey
// An issuer with no Company row (e.g. Government of Ghana) has no table to
// reference, so it is keyed by the normalised issuer name — the same identity
// M8.2's resolveIssuerRef uses ("name:<lower>"); the service validates it
// against real bond issuers.
// The shock type fixes the asset domain (YIELD_BPS → bonds, PRICE_PCT →
// equities), so an issuer's bond shock can never touch its equity. The CHECK
// constraints reject incompatible type/target pairs and out-of-bound values;
// the partial-by-NULL unique indexes forbid two shocks at the same target.
// ---------------------------------------------------------------------------

enum ScenarioShockType {
  /// Parallel change in yield, in basis points (+200 = +2.00 percentage points).
  YIELD_BPS
  /// Percentage change in an equity price (-10 = -10%).
  PRICE_PCT
}

enum ScenarioTargetKind {
  ASSET_CLASS
  ISSUER
  SECURITY
}

enum ScenarioAssetClass {
  /// Treasury bills (M8.5): YIELD_BPS moves the bill reference RATE (simple Act/365).
  TREASURY_BILL
  GOVERNMENT_BOND
  CORPORATE_BOND
  EQUITY
}

model Scenario {
  id          String    @id @default(cuid())
  portfolioId String
  name        String
  description String?
  /// Soft archive — an archived scenario is read-only but can still be run.
  archivedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolio Portfolio       @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  shocks    ScenarioShock[]

  @@index([portfolioId])
  @@index([archivedAt])
}

model ScenarioShock {
  id         String             @id @default(cuid())
  scenarioId String
  targetKind ScenarioTargetKind
  shockType  ScenarioShockType
  /// YIELD_BPS: basis points in [-2000, 2000]. PRICE_PCT: percent in [-100, 1000]. Zero is a valid explicit assumption.
  value      Decimal            @db.Decimal(9, 2)

  assetClass            ScenarioAssetClass?
  companyId             String?
  issuerNameKey         String?
  fixedIncomeSecurityId String?
  securityId            String?
  treasuryBillId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  treasuryBill        TreasuryBill?        @relation(fields: [treasuryBillId], references: [id], onDelete: Restrict)
  scenario            Scenario             @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  company             Company?             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  fixedIncomeSecurity FixedIncomeSecurity? @relation(fields: [fixedIncomeSecurityId], references: [id], onDelete: Restrict)
  security            Security?            @relation(fields: [securityId], references: [id], onDelete: Restrict)

  @@unique([scenarioId, assetClass])
  @@unique([scenarioId, shockType, companyId])
  @@unique([scenarioId, shockType, issuerNameKey])
  @@unique([scenarioId, fixedIncomeSecurityId])
  @@unique([scenarioId, securityId])
  @@unique([scenarioId, treasuryBillId])
  @@index([treasuryBillId])
  @@index([scenarioId])
  @@index([companyId])
  @@index([fixedIncomeSecurityId])
  @@index([securityId])
}
