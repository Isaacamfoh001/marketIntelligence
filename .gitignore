# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
CLAUDE.md
PROJECT.md
.agents
.claude
.windsurf
# production
/build

# misc
.DS_Store
*.pem
# Public CA certificates the app depends on at runtime (no private key
# material) are intentionally tracked despite the blanket *.pem rule above.
!src/lib/ingestion/certs/*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
